---
import DocsLayout from '../layouts/DocsLayout.astro';
import VernacularPanels from '../components/VernacularPanels.astro';
import FeatureCards from '../components/FeatureCards.astro';
import Carousel from '../components/Carousel.astro';
import LevelPicker from '../components/LevelPicker.astro';
import Playground from '../components/Playground.astro';
import ReviewStamp from '../components/ReviewStamp.astro';
import Glossary from '../components/Glossary.astro';
import { siteConfig } from '../../site.config.ts';

import { Content as Dev, frontmatter as devFm } from '../docs/dev.md';
import { Content as Plain, frontmatter as plainFm } from '../docs/plain.md';
import { Content as Eli5, frontmatter as eli5Fm } from '../docs/eli5.md';

// One source: GUIDE.md / INSTALL.md copied in by scripts/sync-docs.mjs.
const sources = import.meta.glob<{ Content: any }>('../docs/source/*.md', { eager: true });
const guide = sources['../docs/source/guide.md'];
const install = sources['../docs/source/install.md'];

// The version shown comes from the repo's own package.json when there is one
// (the theme sits in <repo>/docs or <repo>/site), so it can never go stale.
const pkgs = import.meta.glob<{ default: { version?: string } }>('../../../package.json', { eager: true });
const version = Object.values(pkgs)[0]?.default?.version;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const shot = (name: string) => `${base}/screenshots/${name}`;

const features = [
  { icon: '🧮', title: 'True cost per unit', text: 'Machine wear, electricity, consumables, materials, your labor, a share of rent and bills, and the setup fee spread over the batch.' },
  { icon: '📈', title: 'Margin or markup', text: 'Switch between them and the price stays about the same, or snap the margin to break-even, the market middle or the market high.' },
  { icon: '🧾', title: 'VAT and income tax', text: 'VAT added on the invoice, income tax on profit, or presumptive revenue brackets worked out as an effective rate per job.' },
  { icon: '🔎', title: 'Market check', text: 'Built-in price ranges for FDM, resin, UV and laser work, plus competitor search with links when you add a search key.' },
  { icon: '✉️', title: 'Offer letters', text: 'Fill your own template with the quote, then copy it or download it as a Markdown file.' },
  { icon: '🔒', title: 'Saved in your browser', text: 'No account and no server of ours. Keys are stored only in your browser and sent only to the service they belong to.' },
];

const slides = [
  { title: 'The studio', caption: 'Your machine on the left, the job and its live price on the right.', image: shot('studio.png'), alt: 'MarginCraft studio with machine fleet, job ticket and price' },
  { title: 'Your business, once', caption: 'Wage, bills, taxes and integrations, set once and used in every quote.', image: shot('settings.png'), alt: 'MarginCraft settings: labor, bills, tax, integrations' },
  { title: 'On a phone', caption: 'The job ticket and price come first on small screens.', image: shot('phone.png'), alt: 'MarginCraft on a phone' },
];
---
<DocsLayout title="Overview" home>
  <section class="frame hero reveal" id="top">
    <span class="label">Docs{version ? ` · v${version}` : ''}</span>
    <h1 class="hero-title">{siteConfig.projectName}</h1>
    <p class="hero-sub">{siteConfig.description}</p>
    <div class="btns">
      {siteConfig.heroLinks.map((l) => (
        <a class:list={['btn', { primary: l.primary }]} href={l.href}>{l.label}</a>
      ))}
    </div>
    <div class="pills">
      {siteConfig.heroPills.map((t) => (
        <span class="pill"><i></i>{t}</span>
      ))}
    </div>
  </section>

  <LevelPicker />

  <FeatureCards features={features} title="What it does" />
  <Carousel slides={slides} label="Screenshots" />

<section class="try reveal" id="try" aria-labelledby="try-title">
    <h2 class="section-title" id="try-title">Try it — the real pricing engine, running here</h2>
    <p class="muted">
      This uses the same code as the app (<code>src/lib/calc.ts</code>), not a mock-up. Change any
      number and the price updates. The full app adds overhead from your bills, taxes, presets,
      market checks and offer letters.
    </p>
    <form class="calc" id="calc" aria-describedby="calc-out">
      <fieldset>
        <legend>Machine</legend>
        <label>Purchase cost <input name="purchase" type="number" min="0" step="10" value="800" /></label>
        <label>Expected life (months) <input name="life" type="number" min="1" step="1" value="36" /></label>
        <label>Hours used per month <input name="hours" type="number" min="1" step="1" value="60" /></label>
        <label>Power draw (watts) <input name="watts" type="number" min="0" step="10" value="250" /></label>
        <label>Electricity price per kWh <input name="kwh" type="number" min="0" step="0.01" value="0.25" /></label>
      </fieldset>
      <fieldset>
        <legend>Job (per piece)</legend>
        <label>Machine hours <input name="mh" type="number" min="0" step="0.1" value="3" /></label>
        <label>Your hands-on hours <input name="lh" type="number" min="0" step="0.05" value="0.5" /></label>
        <label>Your hourly wage <input name="wage" type="number" min="0" step="1" value="20" /></label>
        <label>Materials <input name="mat" type="number" min="0" step="0.1" value="4" /></label>
        <label>Margin % <input name="margin" type="number" min="0" max="95" step="1" value="45" /></label>
      </fieldset>
    </form>
    <div class="calc-out" id="calc-out" aria-live="polite">
      <div><span>True cost per piece</span><b data-out="cost">–</b></div>
      <div><span>Machine wear + running, per hour</span><b data-out="rate">–</b></div>
      <div class="big"><span>Price per piece</span><b data-out="price">–</b></div>
      <div><span>Profit per piece</span><b data-out="profit">–</b></div>
    </div>
  </section>


  <section class="doc-body reveal" id="docs" aria-label="Documentation" data-glossary>
    <VernacularPanels>
      <Fragment slot="dev"><ReviewStamp {...devFm} /><Dev /></Fragment>
      <Fragment slot="plain"><ReviewStamp {...plainFm} /><Plain /></Fragment>
      <Fragment slot="eli5"><ReviewStamp {...eli5Fm} /><Eli5 /></Fragment>
    </VernacularPanels>
  </section>

  {/* No "reveal" on Install and Guide: it waits for part of a section to be on screen, which a long section never reaches (found on Video Forge, 18 Nov 2026). */}
  {install && (
    <section class="doc-body doc-source" id="install" aria-label="Install" data-glossary>
      <install.Content />
    </section>
  )}
  {guide && (
    <section class="doc-body doc-source" id="guide" aria-label="Guide" data-glossary>
      <guide.Content />
    </section>
  )}

  {siteConfig.playground.enabled && <Playground />}
  <Glossary />
</DocsLayout>

<script>
  import { computeQuote, fmtMoney } from '../../../src/lib/calc';
  import type { Job, Machine, Settings } from '../../../src/types';

  const form = document.getElementById('calc') as HTMLFormElement | null;
  const out = (key: string) => document.querySelector<HTMLElement>(`[data-out="${key}"]`);

  const update = () => {
    if (!form) return;
    const v = (name: string) => Number((form.elements.namedItem(name) as HTMLInputElement).value) || 0;
    const machine: Machine = {
      id: 'demo', name: 'Demo', type: 'fdm',
      purchaseCost: v('purchase'), salvageValue: 0,
      lifespanMonths: Math.max(1, v('life')), hoursPerMonth: Math.max(1, v('hours')),
      watts: v('watts'), consumablesPerHour: 0, maintenancePerMonth: 0,
    };
    const settings: Settings = {
      currency: 'EUR', hourlyWage: v('wage'), laborBurdenPct: 0, electricityRate: v('kwh'),
      rent: 0, utilities: 0, software: 0, insurance: 0, otherBills: 0, billableHours: 0,
      vatPct: 0, profitTaxPct: 0, regime: 'profit', brackets: [], presumptiveRevenue: 0, marketingMonthly: 0,
    };
    const job: Job = {
      name: 'Demo', machineId: 'demo', machineHours: v('mh'), laborHours: v('lh'),
      materialCost: v('mat'), setupFee: 0, quantity: 1, marginMode: 'margin', marginPct: v('margin'),
      benchmarkId: '', benchmarkUnits: 1,
    };
    const q = computeQuote(job, machine, settings);
    const money = (n: number) => fmtMoney(n, 'EUR');
    out('cost')!.textContent = money(q.unitCost);
    out('rate')!.textContent = `${money(q.machineRate)}/h`;
    out('price')!.textContent = money(q.unitPrice);
    out('profit')!.textContent = money(q.unitPrice - q.unitCost);
  };

  form?.addEventListener('input', update);
  update();
</script>

<style is:global>
  .try { margin: 56px 0; }
  .try .muted { color: var(--dim); max-width: 70ch; }
  .calc { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-top: 20px; }
  .calc fieldset { border: 1px solid var(--border); border-radius: 14px; padding: 14px 16px 6px; margin: 0; background: var(--frame); }
  .calc legend { padding: 0 6px; font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--mint); }
  .calc label { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 10px; font-size: 0.95rem; }
  .calc input { width: 7.5em; padding: 6px 8px; border-radius: 8px; border: 1px solid var(--border-strong); background: var(--ground); color: var(--text); font: inherit; text-align: right; }
  .calc input:focus-visible { outline: 2px solid var(--mint); outline-offset: 2px; }
  .calc-out { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-top: 16px; }
  .calc-out div { border-radius: 12px; padding: 12px 14px; background: var(--frame-2); display: flex; flex-direction: column; gap: 4px; }
  .calc-out span { font-size: 0.85rem; color: var(--dim); }
  .calc-out b { font-size: 1.25rem; font-family: var(--font-mono); }
  .calc-out .big { background: rgba(66, 169, 164, 0.3); }
  .calc-out .big b { font-size: 1.6rem; color: var(--mint); }
</style>
